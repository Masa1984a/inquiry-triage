# TypeSafe AI のAPIキー (必須)
# https://console.typesafe.ai/keys で発行し、このファイルを .env にコピーして貼り付けてください。
# このキーはサーバー側 (app/api/triage/route.ts) でのみ使用し、ブラウザには渡しません。
TYPESAFE_API_KEY=

# 使用モデル (任意)。未設定なら jev-latest。
# デモの応答を固定したい場合はバージョンを明示する (例: jev-1.13.0)。
# TYPESAFE_DEFAULT_MODEL=jev-latest

# ログレベル (任意)。debug にするとリクエスト/レスポンスの本文まで出力される。
# 問い合わせ本文には顧客名・環境名が含まれるため、一時的な調査以外では使用しないこと。
# TYPESAFE_LOG_LEVEL=warn
